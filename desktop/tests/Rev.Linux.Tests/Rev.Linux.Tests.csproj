<Project Sdk="Microsoft.NET.Sdk">

  <!-- Automatic tests of Rev for Linux's screens. They run the real app without a monitor ("headless"),
       press keys and click like you would, and save a picture of each screen (in screens/ next to the tests,
       or the folder in REV_SCREENSHOTS). They run on Windows and on Linux (GitHub's Ubuntu machines). -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rev.Linux\Rev.Linux.csproj" />
  </ItemGroup>

</Project>
