<!--
    Add new cards or edit one. Keys: Ctrl+Enter saves (Save & next when adding), Ctrl+B / Ctrl+I make the
    selected words bold / italic, Tab moves to the next box, Esc closes (asking first if you'd lose text).
-->
<Window x:Class="Rev.App.Views.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource RevWindow}"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Title="New card" Width="780" Height="900" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="700" Margin="32,24,32,16">
                <TextBlock x:Name="HeaderText" Style="{StaticResource TitleText}" Text="New card" />
                <TextBlock x:Name="DeckText" Style="{StaticResource MutedText}" Margin="2,2,0,18" />

                <!-- Which kind of card (only when adding) -->
                <WrapPanel x:Name="KindChoices">
                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="Basic" Content="Basic" Checked="Kind_Checked" />
                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="Reversed" Content="Basic + reversed" Checked="Kind_Checked" />
                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="Cloze" Content="Cloze (fill in the blank)" Checked="Kind_Checked" />
                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="TypeIn" Content="Type the answer" Checked="Kind_Checked" />
                </WrapPanel>
                <TextBlock x:Name="KindLabel" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TealBrush}"
                           Visibility="Collapsed" Margin="2,0,0,4" />
                <TextBlock x:Name="KindExplanation" Style="{StaticResource MutedText}" FontSize="14" Margin="2,2,0,20" />

                <!-- Front (or the cloze text), with Bold / Italic buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FrontLabel" Style="{StaticResource FieldLabel}" Text="Front" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource RoundIconButton}" Width="40" Height="40" Focusable="False"
                                Click="Bold_Click" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8DD;" />
                        </Button>
                        <Button Style="{StaticResource RoundIconButton}" Width="40" Height="40" Margin="8,0,0,0" Focusable="False"
                                Click="Italic_Click" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8DB;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="FrontBox" Style="{StaticResource RevMultiLineTextBox}" MinHeight="100" MaxHeight="260"
                         AutomationProperties.Name="Front" TextChanged="Text_Changed" GotKeyboardFocus="TextBox_GotFocus" />

                <!-- Cloze helper: type a word, click Hide -->
                <StackPanel x:Name="ClozeTools" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HideWordBox" Style="{StaticResource RevTextBox}" Tag="Word to hide"
                                 AutomationProperties.Name="Word to hide" KeyDown="HideWordBox_KeyDown" TextChanged="HideWordBox_TextChanged" />
                        <Button x:Name="HideButton" Grid.Column="1" Style="{StaticResource DangerPillButton}" MinHeight="48"
                                Margin="10,0,0,0" Click="Hide_Click" IsEnabled="False" />
                        <Button x:Name="AddToButton" Grid.Column="2" Style="{StaticResource SecondaryPillButton}" MinHeight="48"
                                Margin="8,0,0,0" Click="AddTo_Click" IsEnabled="False" />
                    </Grid>
                    <TextBlock x:Name="ClozeCountText" FontSize="14" FontWeight="SemiBold" Margin="4,8,0,0" />
                </StackPanel>

                <TextBlock x:Name="BackLabel" Style="{StaticResource FieldLabel}" Text="Back" Margin="4,20,0,8" />
                <TextBox x:Name="BackBox" Style="{StaticResource RevMultiLineTextBox}" MinHeight="150" MaxHeight="320"
                         AutomationProperties.Name="Back" TextChanged="Text_Changed" GotKeyboardFocus="TextBox_GotFocus" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="4,8,0,0"
                           Text="Select words, then press Ctrl+B or Ctrl+I (or click B / I) for bold or italic. Start a line with • or 1. for a list." />

                <!-- Tags -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="Tags" Margin="4,22,0,8" />
                <TextBox x:Name="TagsBox" Style="{StaticResource RevTextBox}" Tag="e.g. parasitology paper_1"
                         AutomationProperties.Name="Tags" TextChanged="TagsBox_TextChanged" />
                <WrapPanel x:Name="TagChips" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="4,2,0,0"
                           Text="Separate tags with spaces. Tags stay filled in for the next card." />
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons along the bottom -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="32,16">
            <Grid MaxWidth="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AddedText" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryPillButton}" MinHeight="54"
                            Content="Done" Click="Secondary_Click" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource TealPillButton}" MinHeight="54" Margin="12,0,0,0"
                            Content="Save &amp; next" Click="Primary_Click" ToolTip="Ctrl+Enter" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
