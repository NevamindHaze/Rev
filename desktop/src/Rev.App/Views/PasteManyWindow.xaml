<!--
    Paste many cards at once: one card per line, with "|" (or a tab) between front and back.
    Ctrl+Enter adds them, Esc closes.
-->
<Window x:Class="Rev.App.Views.PasteManyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource RevWindow}"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Title="Paste many" Width="760" Height="700" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleText}" Text="Paste many" />
            <TextBlock x:Name="DeckText" Style="{StaticResource MutedText}" Margin="2,2,0,16" />
            <TextBlock Style="{StaticResource BodyText}" Text="One card per line. Put a | between the front and the back." />
            <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,14"
                       Text="Example:  Normal canine heart rate | 60–160 bpm    (copying two columns from a spreadsheet works too)" />
        </StackPanel>

        <TextBox x:Name="PasteBox" Grid.Row="1" Style="{StaticResource RevMultiLineTextBox}" AcceptsTab="True"
                 FontSize="17" TextWrapping="NoWrap" AutomationProperties.Name="Cards to paste"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" TextChanged="PasteBox_TextChanged" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryPillButton}" MinHeight="54" Content="Cancel" Click="Cancel_Click" />
            <Button x:Name="AddButton" Style="{StaticResource TealPillButton}" MinHeight="54" Margin="12,0,0,0"
                    Content="Add 0 cards" IsEnabled="False" Click="Add_Click" ToolTip="Ctrl+Enter" />
        </StackPanel>
    </Grid>
</Window>
