<!--
    Rev's colours for DARK mode. Same names as Colors.Light.xaml.
    As in Rev on iPhone, coral, teal and mustard are tuned slightly for dark backgrounds.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#181714" />
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#24231F" />
    <SolidColorBrush x:Key="SoftFillBrush"   Color="#302F29" />

    <SolidColorBrush x:Key="InkBrush"        Color="#F5F1E3" />
    <SolidColorBrush x:Key="MutedInkBrush"   Color="#A8A393" />

    <SolidColorBrush x:Key="CoralBrush"      Color="#E47C93" />
    <SolidColorBrush x:Key="TealBrush"       Color="#58AA97" />
    <SolidColorBrush x:Key="MustardBrush"    Color="#E8AE45" />
    <SolidColorBrush x:Key="SageBrush"       Color="#3E5A4D" />

    <SolidColorBrush x:Key="DarkTextBrush"   Color="#1F1B16" />
    <SolidColorBrush x:Key="OnCoralBrush"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnTealBrush"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnMustardBrush"  Color="#1F1B16" />
    <SolidColorBrush x:Key="OnSageBrush"     Color="#F5F1E3" />

    <Color x:Key="TitleBarColor">#181714</Color>
    <Color x:Key="TitleTextColor">#F5F1E3</Color>
</ResourceDictionary>
