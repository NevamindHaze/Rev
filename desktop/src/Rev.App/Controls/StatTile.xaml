<!-- A small number tile, like "12 · Due today": a coloured circle icon, a big number and a label. -->
<UserControl x:Class="Rev.App.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource SoftFillBrush}" CornerRadius="{StaticResource TileCorner}"
            Padding="8,18">
        <StackPanel HorizontalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Tint, ElementName=Root}">
                <TextBlock Style="{StaticResource IconText}" FontSize="16"
                           Foreground="{DynamicResource DarkTextBrush}"
                           Text="{Binding Glyph, ElementName=Root}" />
            </Border>
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" Text="{Binding Value, ElementName=Root}" />
            <TextBlock HorizontalAlignment="Center" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedInkBrush}" Text="{Binding Label, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>
