<!--
    A searchable, filterable, sortable list of cards. Used inside a deck and on the "All cards" screen.
    Click a card to edit it; right-click it (or its ⋯ button) for tags, suspend, leech and delete.
-->
<UserControl x:Class="Rev.App.Controls.CardBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBox x:Name="SearchBox" Style="{StaticResource RevTextBox}" Tag="Search cards or tags (Ctrl+F)"
                 AutomationProperties.Name="Search cards" TextChanged="SearchBox_TextChanged"
                 PreviewKeyDown="SearchBox_PreviewKeyDown" />

        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="StateChip" Style="{StaticResource ChipButton}" Click="StateChip_Click" ToolTip="Show only some cards" />
            <Button x:Name="TagChip" Style="{StaticResource ChipButton}" Click="TagChip_Click" ToolTip="Show only cards with a tag" />
            <Button x:Name="SortChip" Style="{StaticResource ChipButton}" Click="SortChip_Click" ToolTip="Change the order" />
        </WrapPanel>

        <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" FontSize="13" FontWeight="SemiBold" Margin="4,4,0,10" />
        <StackPanel x:Name="CardList" />
        <Button x:Name="MoreButton" Style="{StaticResource SecondaryPillButton}" MinHeight="48" HorizontalAlignment="Center"
                Margin="0,6,0,0" Click="More_Click" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
