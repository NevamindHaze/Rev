<!--
    Add new cards or edit one. Keys: Ctrl+Enter saves (Save & next when adding), Ctrl+B / Ctrl+I make the
    selected words bold / italic, Tab moves to the next box, Esc closes (asking first if you'd lose text).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:controls="clr-namespace:Rev.Linux.Controls"
        x:Class="Rev.Linux.Views.CardEditorWindow"
        Icon="avares://Rev/Assets/AppIcon.png"
        Title="New card" Width="780" Height="900" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Panel>
        <Grid RowDefinitions="*,Auto">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="32,24,32,16">
                    <TextBlock x:Name="HeaderText" Classes="title" Text="New card" />
                    <TextBlock x:Name="DeckText" Classes="muted" Margin="2,2,0,18" />

                    <!-- Which kind of card (only when adding) -->
                    <WrapPanel x:Name="KindChoices">
                        <RadioButton Classes="choice" GroupName="Kind" Tag="Basic" Content="Basic" IsCheckedChanged="Kind_Changed" />
                        <RadioButton Classes="choice" GroupName="Kind" Tag="Reversed" Content="Basic + reversed" IsCheckedChanged="Kind_Changed" />
                        <RadioButton Classes="choice" GroupName="Kind" Tag="Cloze" Content="Cloze (fill in the blank)" IsCheckedChanged="Kind_Changed" />
                        <RadioButton Classes="choice" GroupName="Kind" Tag="TypeIn" Content="Type the answer" IsCheckedChanged="Kind_Changed" />
                    </WrapPanel>
                    <TextBlock x:Name="KindLabel" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TealBrush}"
                               IsVisible="False" Margin="2,0,0,4" />
                    <TextBlock x:Name="KindExplanation" Classes="muted" FontSize="14" Margin="2,2,0,20" />

                    <!-- Front (or the cloze text), with Bold / Italic buttons -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="FrontLabel" Classes="label" Text="Front" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Classes="rev secondary round" Width="40" Height="40" Focusable="False"
                                    Click="Bold_Click" ToolTip.Tip="Bold (Ctrl+B)" AutomationProperties.Name="Bold">
                                <mi:MaterialIcon Kind="FormatBold" Width="20" Height="20" />
                            </Button>
                            <Button Classes="rev secondary round" Width="40" Height="40" Margin="8,0,0,0" Focusable="False"
                                    Click="Italic_Click" ToolTip.Tip="Italic (Ctrl+I)" AutomationProperties.Name="Italic">
                                <mi:MaterialIcon Kind="FormatItalic" Width="20" Height="20" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="FrontBox" Classes="rev multi" MinHeight="100" MaxHeight="260"
                             AutomationProperties.Name="Front" />

                    <!-- Cloze helper: type a word, click Hide -->
                    <StackPanel x:Name="ClozeTools" Margin="0,12,0,0" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="HideWordBox" Classes="rev" Watermark="Word to hide" AutomationProperties.Name="Word to hide" />
                            <Button x:Name="HideButton" Grid.Column="1" Classes="rev danger" MinHeight="48" Margin="10,0,0,0"
                                    Click="Hide_Click" IsEnabled="False" />
                            <Button x:Name="AddToButton" Grid.Column="2" Classes="rev secondary" MinHeight="48" Margin="8,0,0,0"
                                    Click="AddTo_Click" IsEnabled="False" />
                        </Grid>
                        <TextBlock x:Name="ClozeCountText" FontSize="14" FontWeight="SemiBold" Margin="4,8,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="BackLabel" Classes="label" Text="Back" Margin="4,20,0,8" />
                    <TextBox x:Name="BackBox" Classes="rev multi" MinHeight="150" MaxHeight="320" AutomationProperties.Name="Back" />
                    <TextBlock Classes="muted" FontSize="13" Margin="4,8,0,0"
                               Text="Select words, then press Ctrl+B or Ctrl+I (or click B / I) for bold or italic. Start a line with • or 1. for a list." />

                    <!-- Tags -->
                    <TextBlock Classes="label" Text="Tags" Margin="4,22,0,8" />
                    <TextBox x:Name="TagsBox" Classes="rev" Watermark="e.g. parasitology paper_1" AutomationProperties.Name="Tags" />
                    <WrapPanel x:Name="TagChips" Margin="0,10,0,0" />
                    <TextBlock Classes="muted" FontSize="13" Margin="4,2,0,0"
                               Text="Separate tags with spaces. Tags stay filled in for the next card." />
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons along the bottom -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="32,16">
                <Grid MaxWidth="700" ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="AddedText" Classes="muted" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SecondaryButton" Classes="rev secondary" MinHeight="54" Content="Done" Click="Secondary_Click" />
                        <Button x:Name="PrimaryButton" Classes="rev teal" MinHeight="54" Margin="12,0,0,0"
                                Content="Save &amp; next" Click="Primary_Click" ToolTip.Tip="Ctrl+Enter" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <controls:DialogLayer />
    </Panel>
</Window>
