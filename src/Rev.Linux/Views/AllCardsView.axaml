<!--
    Every card from every deck in one list, with the same search, filters, tags and sorting as a deck.
    Ctrl+F jumps to the search box, Esc goes back.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Rev.Linux.Controls"
             x:Class="Rev.Linux.Views.AllCardsView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1200" Margin="{StaticResource PagePadding}">
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                <TextBlock Grid.Column="1" Classes="title" Text="All cards" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="EmptyText" Classes="muted" Margin="4,0,0,0" Text="No cards yet." />
            <controls:CardBrowser x:Name="Browser" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
