<!--
    The review screen: question → Show answer → rate. Minimal on purpose.
    Keys: Space (or Enter) shows the answer, 1–4 rate it, Ctrl+Z undoes, E edits the card, Esc goes back.
    Clicking works everywhere too: click the card to show the answer.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Rev.Linux.Controls"
             x:Class="Rev.Linux.Views.ReviewView"
             Focusable="True">
    <Grid MaxWidth="900" Margin="32,22,32,20" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- ←, the deck's name, Undo and Edit -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="rev secondary round" Click="Back_Click" ToolTip.Tip="Back (Esc)"
                    AutomationProperties.Name="Back" Focusable="False">
                <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1" Classes="heading" Margin="16,0,12,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="UndoButton" Classes="rev secondary" MinHeight="46" Padding="20,0"
                        Click="Undo_Click" ToolTip.Tip="Undo the last answer (Ctrl+Z)" AutomationProperties.Name="Undo" Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="Undo" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Undo" FontSize="16" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Classes="rev secondary" MinHeight="46" Padding="20,0" Margin="10,0,0,0"
                        Click="Edit_Click" ToolTip.Tip="Edit this card (E)" AutomationProperties.Name="Edit card" Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="PencilOutline" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Edit" FontSize="16" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3 new · 2 learning · 5 review -->
        <StackPanel x:Name="CountsPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,16" />

        <!-- The card -->
        <Border x:Name="CardFace" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource Corner}"
                Cursor="Hand" PointerReleased="CardFace_PointerReleased">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,30">
                    <TextBlock Text="QUESTION" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MutedInkBrush}" Margin="0,0,0,12" />
                    <controls:CardTextView x:Name="FrontView" TextSize="26" TextElement.FontWeight="SemiBold" />

                    <!-- Type the answer: a box before revealing, the result after -->
                    <TextBox x:Name="TypeBox" Classes="rev" Watermark="Type your answer, then press Enter"
                             Margin="0,16,0,0" FontSize="19" IsVisible="False" AutomationProperties.Name="Your answer" />
                    <StackPanel x:Name="TypedResult" Orientation="Horizontal" Margin="0,16,0,0" IsVisible="False">
                        <mi:MaterialIcon x:Name="TypedIcon" Width="22" Height="22" Margin="0,0,10,0" />
                        <TextBlock x:Name="TypedText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="AnswerPanel" IsVisible="False">
                        <Border Height="3" CornerRadius="2" Background="{DynamicResource SoftFillBrush}" Margin="0,24,0,20" />
                        <TextBlock Text="ANSWER" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MutedInkBrush}" Margin="0,0,0,12" />
                        <controls:CardTextView x:Name="BackView" TextSize="22" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Nothing left to study -->
        <StackPanel x:Name="FinishedPanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False">
            <mi:MaterialIcon x:Name="FinishedIcon" Width="68" Height="68" Foreground="{DynamicResource TealBrush}" />
            <TextBlock x:Name="FinishedTitle" Classes="title" HorizontalAlignment="Center" Margin="0,18,0,8" />
            <TextBlock x:Name="FinishedMessage" Classes="muted" FontSize="16" TextAlignment="Center" />
            <Button x:Name="CheckAgainButton" Classes="rev teal" Content="Check again" Margin="0,22,0,0"
                    HorizontalAlignment="Center" Click="CheckAgain_Click" />
        </StackPanel>

        <!-- Show answer, or the four answer buttons -->
        <Panel Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="ShowAnswerButton" Classes="rev" MinHeight="76" HorizontalAlignment="Stretch" Content="Show answer"
                    Click="ShowAnswer_Click" ToolTip.Tip="Space" Focusable="False" />
            <UniformGrid x:Name="RatingGrid" Columns="4" IsVisible="False" Margin="-5,0" />
        </Panel>

        <TextBlock x:Name="KeysHint" Grid.Row="4" Classes="muted" FontSize="13" HorizontalAlignment="Center"
                   Margin="0,12,0,0" Text="Space shows the answer · 1–4 rate · Ctrl+Z undo · E edit · Esc back" />
    </Grid>
</UserControl>
