<!--
    The main window. For now it shows the Home screen's layout with no data yet;
    the next steps fill in real numbers and decks.
-->
<Window x:Class="Rev.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Rev.App.Controls"
        Style="{StaticResource RevWindow}"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Title="Rev" Width="1040" Height="760" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Content stays a comfortable width in the middle, even on a wide screen. -->
        <StackPanel MaxWidth="880" Margin="{StaticResource PagePadding}">

            <!-- Greeting and today's date -->
            <TextBlock x:Name="GreetingText" Style="{StaticResource HeadingText}" Text="Hi there 👋" />
            <TextBlock x:Name="DateText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

            <!-- Today's numbers -->
            <UniformGrid Columns="3" Margin="0,24,0,0">
                <controls:StatTile x:Name="DueTile" Margin="0,0,8,0" Label="Due today"
                                   Glyph="&#xE823;" Tint="{DynamicResource TealBrush}" />
                <controls:StatTile x:Name="NewTile" Margin="4,0,4,0" Label="New"
                                   Glyph="&#xE734;" Tint="{DynamicResource CoralBrush}" />
                <controls:StatTile x:Name="DoneTile" Margin="8,0,0,0" Label="Done today"
                                   Glyph="&#xE73E;" Tint="{DynamicResource MustardBrush}" />
            </UniformGrid>

            <Button Style="{StaticResource PillButton}" Margin="0,14,0,0" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="16" Text="&#xE768;" Margin="0,0,10,0" />
                    <TextBlock Text="Review all decks" />
                </StackPanel>
            </Button>

            <!-- Decks -->
            <TextBlock Style="{StaticResource TitleText}" Text="Your decks" Margin="0,28,0,14" />
            <Border Style="{StaticResource SurfaceCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="40" Text="&#xE8F1;"
                               Foreground="{DynamicResource TealBrush}" />
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="22" Text="No decks yet"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"
                               Text="Make your first deck, or import an Anki deck in Settings." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
