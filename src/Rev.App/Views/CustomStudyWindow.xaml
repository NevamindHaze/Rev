<!--
    Custom study: an extra session outside today's queue, like Anki's.
    More new cards, forgotten cards, review ahead, or study by tag. Enter starts, Esc closes.
-->
<Window x:Class="Rev.App.Views.CustomStudyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource RevWindow}"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Title="Custom study" Width="720" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleText}" Text="Custom study" />
            <TextBlock x:Name="DeckText" Style="{StaticResource MutedText}" Margin="2,2,0,16" />
            <WrapPanel>
                <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="MoreNew" Content="More new cards" IsChecked="True" Checked="Kind_Checked" />
                <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="Forgotten" Content="Forgotten cards" Checked="Kind_Checked" />
                <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="ReviewAhead" Content="Review ahead" Checked="Kind_Checked" />
                <RadioButton Style="{StaticResource ChoicePill}" GroupName="Kind" Tag="ByTag" Content="Study by tag" Checked="Kind_Checked" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="ExplainText" Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" Margin="2,0,0,14" />

                <!-- How many cards, or how many days -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NumberLabel" Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource RoundIconButton}" Click="Fewer_Click" AutomationProperties.Name="Fewer">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE738;" />
                        </Button>
                        <TextBlock x:Name="NumberText" Width="86" FontSize="19" FontWeight="Bold"
                                   TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                        <Button Style="{StaticResource RoundIconButton}" Click="More_Click" AutomationProperties.Name="More">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Study by tag only -->
                <StackPanel x:Name="TagPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChoicePill}" GroupName="TagCards" Tag="All" Content="All cards" IsChecked="True" Checked="TagCards_Checked" />
                        <RadioButton Style="{StaticResource ChoicePill}" GroupName="TagCards" Tag="NewOnly" Content="New only" Checked="TagCards_Checked" />
                        <RadioButton Style="{StaticResource ChoicePill}" GroupName="TagCards" Tag="StudiedOnly" Content="Studied only" Checked="TagCards_Checked" />
                    </WrapPanel>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChoicePill}" GroupName="Order" Content="Random order" IsChecked="True" Checked="Order_Checked" />
                        <RadioButton x:Name="OldestFirstChoice" Style="{StaticResource ChoicePill}" GroupName="Order" Content="Oldest first" Checked="Order_Checked" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TAGS" Margin="2,12,0,8" />
                    <WrapPanel x:Name="TagChoices" />
                    <TextBlock x:Name="TagsHint" Style="{StaticResource MutedText}" FontSize="14" Margin="2,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,16,0"
                       Text="Answers count as normal reviews and reschedule the cards." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryPillButton}" MinHeight="54" Content="Cancel" Click="Cancel_Click" />
                <Button x:Name="StartButton" Style="{StaticResource TealPillButton}" MinHeight="54" Margin="12,0,0,0"
                        Content="Study 0 cards" IsEnabled="False" Click="Start_Click" ToolTip="Enter" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
