<!--
    Settings: your name, new cards per day, the scheduling algorithm and its target memory, and About.
    Every change is saved straight away. Esc goes back.
    (Backup and Anki import/export will be added here in the next steps.)
-->
<UserControl x:Class="Rev.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource HeadingText}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="2,12,0,0" />
        </Style>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="760" Margin="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource RoundIconButton}" Click="Back_Click" ToolTip="Back (Esc)"
                        AutomationProperties.Name="Back" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" />
                </Button>
                <TextBlock Grid.Column="1" Style="{StaticResource TitleText}" Text="Settings" Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- You -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="You" />
                    <TextBox x:Name="NameBox" Style="{StaticResource RevTextBox}" Tag="Your name"
                             AutomationProperties.Name="Your name" TextChanged="NameBox_TextChanged" />
                    <TextBlock Style="{StaticResource Note}" Text="Shown in the greeting on the Home screen." />
                </StackPanel>
            </Border>

            <!-- Study -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Study" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="17" VerticalAlignment="Center" Text="New cards per day" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource RoundIconButton}" Click="Fewer_Click" ToolTip="5 fewer"
                                    AutomationProperties.Name="Fewer new cards">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE738;" />
                            </Button>
                            <TextBox x:Name="PerDayBox" Style="{StaticResource RevTextBox}" Width="86" Margin="10,0"
                                     TextAlignment="Center" FontWeight="Bold" MaxLength="3"
                                     AutomationProperties.Name="New cards per day"
                                     PreviewTextInput="PerDayBox_PreviewTextInput" TextChanged="PerDayBox_TextChanged" />
                            <Button Style="{StaticResource RoundIconButton}" Click="More_Click" ToolTip="5 more"
                                    AutomationProperties.Name="More new cards">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Note}" Text="How many never-seen cards to introduce each day (0–500)." />
                </StackPanel>
            </Border>

            <!-- Scheduling -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Scheduling" />
                    <WrapPanel>
                        <RadioButton x:Name="FsrsChoice" Style="{StaticResource ChoicePill}" GroupName="Scheduler"
                                     Content="FSRS (recommended)" Checked="Scheduler_Checked" />
                        <RadioButton x:Name="Sm2Choice" Style="{StaticResource ChoicePill}" GroupName="Scheduler"
                                     Content="SM-2 (classic)" Checked="Scheduler_Checked" />
                    </WrapPanel>
                    <StackPanel x:Name="RetentionPanel" Margin="0,14,0,0">
                        <TextBlock x:Name="RetentionText" Style="{StaticResource BodyText}" FontSize="17" FontWeight="SemiBold" />
                        <Slider x:Name="RetentionSlider" Style="{StaticResource RevSlider}" Margin="0,8,0,0"
                                Minimum="80" Maximum="97" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
                                TickFrequency="1" AutomationProperties.Name="Target memory" ValueChanged="RetentionSlider_ValueChanged" />
                        <Grid Margin="4,2,4,0">
                            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Text="80% · fewer reviews" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Text="97% · remember more" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="FSRS predicts when you're about to forget each card. A higher target means you remember more but review more often; 90% suits most people. Switching algorithms keeps all your cards and progress." />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="About" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyText}" FontSize="16" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0" />
                    <Button Style="{StaticResource SecondaryPillButton}" MinHeight="44" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Click="OpenFolder_Click" Content="Open data folder" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
