<!--
    The Home screen: a greeting, today's numbers, and your decks as big colourful tiles.
    Ctrl+N makes a new deck. On a deck tile: F2 renames, Delete deletes (or right-click).
-->
<UserControl x:Class="Rev.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rev.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <!-- Content stays a comfortable width in the middle, even on a wide screen. -->
        <StackPanel MaxWidth="900" Margin="{StaticResource PagePadding}">

            <!-- Greeting and today's date, with the New deck button on the right -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="GreetingText" Style="{StaticResource HeadingText}" Text="Hi there 👋" />
                    <TextBlock x:Name="DateText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryPillButton}" MinHeight="48"
                        VerticalAlignment="Center" Click="NewDeck_Click" ToolTip="New deck (Ctrl+N)"
                        AutomationProperties.Name="New deck">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="New deck" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Today's numbers -->
            <UniformGrid Columns="3" Margin="0,24,0,0">
                <controls:StatTile x:Name="DueTile" Margin="0,0,8,0" Label="Due today"
                                   Glyph="&#xE823;" Tint="{DynamicResource TealBrush}" />
                <controls:StatTile x:Name="NewTile" Margin="4,0,4,0" Label="New"
                                   Glyph="&#xE734;" Tint="{DynamicResource CoralBrush}" />
                <controls:StatTile x:Name="DoneTile" Margin="8,0,0,0" Label="Done today"
                                   Glyph="&#xE73E;" Tint="{DynamicResource MustardBrush}" />
            </UniformGrid>

            <Button x:Name="ReviewAllButton" Style="{StaticResource PillButton}" Margin="0,14,0,0" Click="ReviewAll_Click"
                    AutomationProperties.Name="Review all decks">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="16" Text="&#xE768;" Margin="0,0,10,0" />
                    <TextBlock Text="Review all decks" />
                </StackPanel>
            </Button>

            <!-- Decks -->
            <TextBlock Style="{StaticResource TitleText}" Text="Your decks" Margin="0,30,0,14" />
            <!-- Each tile has 7 px on each side; the grid's -7 px edges line the tiles up with the page. -->
            <UniformGrid x:Name="DeckGrid" Columns="2" Margin="-7,0" />
            <Border x:Name="EmptyState" Style="{StaticResource SurfaceCard}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="40" Text="&#xE8F1;"
                               Foreground="{DynamicResource TealBrush}" />
                    <TextBlock Style="{StaticResource HeadingText}" FontSize="22" Text="No decks yet"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"
                               Text="Click New deck to make your first one, or import an Anki deck in Settings." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
